# Normalize line endings in the repository (LF), convert on checkout per platform
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.ico  binary
*.pfx  binary
*.zip  binary
