# Copy to .env (git-ignored) and change the values: cp .env.example .env
# Local development only. Never reuse these anywhere else.

# PostgreSQL superuser (only used by the init script and for admin access)
POSTGRES_PASSWORD=change_me_admin

# One user per service database (created by deploy/local/init-databases.sh)
CATALOG_DB_PASSWORD=change_me_catalog
ORDERS_DB_PASSWORD=change_me_orders
