@baseUrl = http://localhost:5102
@keyboard = b1f0c8a2-4c1e-4b7e-9a51-0f6d2c3a1001
@monitor = b1f0c8a2-4c1e-4b7e-9a51-0f6d2c3a1003

### Place an order (change the key for a new order; reuse it to test retries)
# @name placeOrder
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json
Idempotency-Key: checkout-001

{
  "items": [
    { "productId": "{{keyboard}}", "quantity": 2, "price": 0.01 },
    { "productId": "{{monitor}}", "quantity": 1 }
  ]
}

### Get the order (price must be Catalog's 89.99, not the 0.01 sent above)
GET {{baseUrl}}/api/v1/orders/{{placeOrder.response.body.orderId}}

### Same order as another customer -> 404
GET {{baseUrl}}/api/v1/orders/{{placeOrder.response.body.orderId}}
X-Customer-Id: 11111111-1111-4111-8111-111111111111

### Missing Idempotency-Key -> 400
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json

{ "items": [ { "productId": "{{keyboard}}", "quantity": 1 } ] }

### Unknown product -> 422
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json
Idempotency-Key: checkout-unknown

{ "items": [ { "productId": "00000000-0000-0000-0000-000000000001", "quantity": 1 } ] }

### Quantity 0 -> 400
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json
Idempotency-Key: checkout-zero

{ "items": [ { "productId": "{{keyboard}}", "quantity": 0 } ] }
