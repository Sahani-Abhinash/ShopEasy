<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- API: HTTP endpoints, request/response contracts, status codes. No business rules (Chapter 2, §3). -->
  <PropertyGroup>
    <UserSecretsId>shopeasy-orders-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Needed in the startup project for `dotnet ef` -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\ShopEasy.ServiceDefaults\ShopEasy.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Orders.Infrastructure\Orders.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orders.Api.IntegrationTests" />
  </ItemGroup>

</Project>
